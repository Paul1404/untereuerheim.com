---
import { getCollection } from "astro:content";

const entries = (await getCollection("chronik")).sort(
  (a, b) => a.data.sortKey - b.data.sortKey,
);
---
<section id="chronik" class="relative scroll-mt-24 py-28 sm:py-36">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="mb-4 font-sans text-[11px] uppercase tracking-[0.28em] text-[color:var(--color-muted)]">
        Zwei. Chronik
      </p>
      <h2 class="font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl">
        Über tausend Jahre, in zehn Stationen.
      </h2>
      <p class="mt-5 font-serif text-lg italic text-[color:var(--color-ink-soft)]">
        Eine kurze Chronik von 880 bis heute. Was geblieben ist und was sich verändert hat.
      </p>
    </div>

    <ol class="relative mt-20 sm:mt-28">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-0 bottom-0 left-6 w-px bg-gradient-to-b from-transparent via-[color:var(--color-line-strong)] to-transparent sm:left-1/2 sm:-translate-x-1/2"
      ></div>

      {entries.map((entry, i) => {
        const left = i % 2 === 0;
        return (
          <li class="reveal relative mb-16 sm:mb-24 last:mb-0">
            <span
              aria-hidden="true"
              class="absolute left-6 top-3 -translate-x-1/2 sm:left-1/2"
            >
              <span class="block h-2.5 w-2.5 rounded-full bg-[color:var(--color-sandstone)] ring-4 ring-[color:var(--color-paper)] shadow-[0_0_0_1px_var(--color-line-strong)]"></span>
            </span>

            <div class={`grid grid-cols-1 gap-x-12 sm:grid-cols-2 ${left ? "" : "sm:[&>*:first-child]:order-2"}`}>
              <div class={`pl-14 sm:pl-0 ${left ? "sm:pr-12 sm:text-right" : "sm:pl-12 sm:text-left"}`}>
                <div class={`inline-flex flex-col ${left ? "sm:items-end" : "sm:items-start"} items-start`}>
                  <span class="font-serif text-[clamp(2.75rem,5.5vw,4.25rem)] leading-none tracking-tight text-[color:var(--color-sandstone)]">
                    {entry.data.year}
                  </span>
                  <span class={`mt-2 h-px w-12 bg-[color:var(--color-line-strong)] ${left ? "sm:ml-auto" : ""}`}></span>
                </div>
              </div>

              <div class={`pl-14 sm:pl-0 ${left ? "sm:pl-12" : "sm:pr-12"}`}>
                <h3 class="font-serif text-2xl leading-tight text-[color:var(--color-ink)]">
                  {entry.data.title}
                </h3>
                <p class="mt-3 max-w-prose text-[15.5px] leading-relaxed text-[color:var(--color-ink-soft)]">
                  {entry.data.description}
                </p>
              </div>
            </div>
          </li>
        );
      })}
    </ol>

    <div class="reveal mx-auto mt-12 max-w-2xl text-center">
      <p class="font-serif text-lg italic text-[color:var(--color-muted)]">
        Die Wallfahrt nach Dettelbach wird jedes Jahr aufs Neue gegangen.
      </p>
    </div>
  </div>
</section>
