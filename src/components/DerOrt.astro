---
import Figure from "./Figure.astro";
import luftbild from "../assets/images/luftbild-untereuerheim.jpg";
import historisch from "../assets/images/u-heim-historisch.png";
import stufenlinde from "../assets/images/stufenlinde-uheim.jpg";

const fakten: { label: string; value: string }[] = [
  { label: "Postleitzahl", value: "97508" },
  { label: "Kfz-Kennzeichen", value: "SW" },
  { label: "Koordinaten", value: "50.0134° N, 10.3562° O" },
  { label: "Einwohner", value: "rund 780" },
  { label: "Gemeinde", value: "Grettstadt" },
  { label: "Landkreis", value: "Schweinfurt" },
  { label: "Regierungsbezirk", value: "Unterfranken" },
  { label: "Bundesland", value: "Bayern" },
  { label: "Eingemeindung", value: "1. Mai 1978" },
  { label: "Erstmals erwähnt", value: "um das Jahr 800" },
  { label: "Pfarrei", value: "St. Gallus, Bistum Würzburg" },
  { label: "Nachbarort am linken Ufer", value: "Obereuerheim" },
];
---
<section id="der-ort" class="relative scroll-mt-24 py-28 sm:py-36">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="reveal mb-20 sm:mb-28">
      <Figure
        src={luftbild}
        alt="Luftbild von Untereuerheim mit dem Kirchturm von St. Gallus, im Hintergrund der Main."
        caption="Luftbild von Untereuerheim am rechten Mainufer."
        aspect="16 / 9"
      />
    </div>

    <div class="grid grid-cols-1 items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="reveal lg:col-span-5 lg:sticky lg:top-28">
        <p class="mb-4 font-sans text-[11px] uppercase tracking-[0.28em] text-[color:var(--color-muted)]">
          Eins. Der Ort
        </p>
        <h2 class="font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl">
          Lage und Ortsbild.
        </h2>
      </div>

      <div class="reveal lg:col-span-7">
        <div class="space-y-6 font-serif text-[1.2rem] leading-[1.75] text-[color:var(--color-ink-soft)] sm:text-[1.28rem]">
          <p>
            Untereuerheim liegt nordöstlich von Grettstadt, zwischen Schweinfurt und Haßfurt, am rechten Ufer des Mains. Die Pfarrkirche St. Gallus steht in der Ortsmitte, daneben die Stufenlinde und das Wegkreuz.
          </p>
          <p>
            Rund 780 Einwohner. Landwirtschaft, eine arbeitende Mühle und die Pfarrei prägen den Ort. Über den Mainsteg gelangt man fußläufig nach Obereuerheim auf das gegenüberliegende Ufer.
          </p>
          <p class="font-sans text-[15px] not-italic leading-relaxed text-[color:var(--color-muted)]">
            Postleitzahl 97508. Landkreis Schweinfurt, Regierungsbezirk Unterfranken, Freistaat Bayern. Ortsteil der Gemeinde Grettstadt seit dem 1. Mai 1978.
          </p>
        </div>

        <div class="reveal mt-12">
          <Figure
            src={historisch}
            alt="Vierteilige historische Ansichtskarte mit alten Aufnahmen von Untereuerheim."
            caption="Historische Ansichten von Untereuerheim."
            aspect="3 / 2"
          />
        </div>

        <div class="reveal mt-14">
          <Figure
            src={stufenlinde}
            alt="Die Stufenlinde im Ortskern von Untereuerheim, eine in mehreren Etagen gezogene Linde, daneben ein Wegkreuz."
            caption="Stufenlinde im Ortskern. Foto: baumkunde.de."
            aspect="3 / 2"
          />
        </div>
      </div>
    </div>

    <div class="reveal mt-24 sm:mt-32">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="mb-4 font-sans text-[11px] uppercase tracking-[0.28em] text-[color:var(--color-muted)]">
            Daten und Fakten
          </p>
          <h3 class="font-serif text-3xl leading-[1.1] tracking-tight sm:text-4xl">
            Auf einen Blick.
          </h3>
          <p class="mt-5 max-w-md font-serif text-lg italic leading-snug text-[color:var(--color-ink-soft)]">
            Die wichtigsten Eckdaten zu Untereuerheim.
          </p>
        </div>

        <div class="lg:col-span-7">
          <dl class="grid grid-cols-1 gap-x-10 gap-y-5 sm:grid-cols-2">
            {fakten.map((f) => (
              <div class="flex flex-col gap-1 border-b border-[color:var(--color-line)] pb-4">
                <dt class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">
                  {f.label}
                </dt>
                <dd class="font-serif text-lg text-[color:var(--color-ink)]">
                  {f.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
