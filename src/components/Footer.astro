---
const year = new Date().getFullYear();
---
<footer class="relative mt-12 border-t border-[color:var(--color-line)]">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:px-8 sm:py-16">
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
      <div>
        <p class="font-serif text-2xl text-[color:var(--color-ink)]">Untereuerheim</p>
        <p class="mt-2 max-w-md text-[14px] leading-relaxed text-[color:var(--color-muted)]">
          Untereuerheim, Ortsteil von Grettstadt, Landkreis Schweinfurt.
        </p>
      </div>
      <p class="text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">
        Am Main, seit 880. {year}.
      </p>
    </div>
  </div>
</footer>
