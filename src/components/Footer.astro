---
const year = new Date().getFullYear();
---
<footer class="relative mt-12 border-t border-[color:var(--color-line)]">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:px-8 sm:py-16">
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
      <div>
        <p class="font-serif text-2xl text-[color:var(--color-ink)]">Untereuerheim</p>
        <p class="mt-2 max-w-md text-[14px] leading-relaxed text-[color:var(--color-muted)]">
          Untereuerheim, Ortsteil von Grettstadt, Landkreis Schweinfurt.
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 text-[13px] text-[color:var(--color-ink-soft)] sm:items-end">
        <ul class="flex items-center gap-6">
          <li>
            <a href="/impressum" class="link-underline transition-colors hover:text-[color:var(--color-sandstone)]">Impressum</a>
          </li>
          <li>
            <a href="/datenschutz" class="link-underline transition-colors hover:text-[color:var(--color-sandstone)]">Datenschutz</a>
          </li>
          <li>
            <a
              href="https://github.com/Paul1404/untereuerheim.com"
              rel="external noopener"
              target="_blank"
              aria-label="Quellcode auf GitHub"
              class="inline-flex items-center gap-1.5 transition-colors hover:text-[color:var(--color-sandstone)]"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 16 16"
                width="16"
                height="16"
                fill="currentColor"
                class="shrink-0"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          </li>
        </ul>
        <p class="text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">
          {year}
        </p>
      </div>
    </div>
  </div>
</footer>
