---
import { Image } from "astro:assets";
import luftbild from "../assets/images/luftbild-untereuerheim.png";
---
<section class="hero relative isolate overflow-hidden">
  <div class="hero-bg" aria-hidden="true">
    <Image
      src={luftbild}
      alt=""
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-bg-img"
    />
  </div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-between px-6 pt-32 pb-12 sm:px-8 sm:pt-40 sm:pb-16">
    <div class="max-w-3xl">
      <div class="hero-enter mb-7 flex items-center justify-between gap-4 border-b border-[color:var(--color-line-strong)] pb-4 font-sans text-[11px] uppercase tracking-[0.26em] text-[color:var(--color-muted)]" style="--enter-delay:80ms">
        <span>Unterfranken · Bayern</span>
        <span class="hidden sm:inline">Erstmals erwähnt um 800</span>
      </div>
      <h1 class="hero-enter font-serif text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.95] tracking-[-0.02em] text-[color:var(--color-ink)]" style="--enter-delay:220ms">
        <span class="headline-word">Untereuer<span class="italic text-[color:var(--color-sandstone)]">heim</span></span>
      </h1>
      <p class="hero-enter mt-8 max-w-xl text-balance font-serif text-[clamp(1.25rem,2.1vw,1.6rem)] italic leading-snug text-[color:var(--color-ink-soft)]" style="--enter-delay:360ms">
        Ortsteil von Grettstadt im Landkreis Schweinfurt, am rechten Ufer des Mains.
      </p>
      <p class="hero-enter mt-5 max-w-lg text-[15px] leading-relaxed text-[color:var(--color-muted)]" style="--enter-delay:470ms">
        Rund 780 Einwohner. Der Ort liegt zwischen Schweinfurt und Haßfurt und ist seit dem 9. Jahrhundert urkundlich belegt.
      </p>
    </div>

    <div class="mt-16 flex items-end justify-between gap-6">
      <dl class="hero-enter grid grid-cols-2 gap-x-10 gap-y-3 text-[13px] sm:grid-cols-4" style="--enter-delay:620ms">
        <div>
          <dt class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Lage</dt>
          <dd class="mt-1 font-serif text-lg text-[color:var(--color-ink)]">Am Main</dd>
        </div>
        <div>
          <dt class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Einwohner</dt>
          <dd class="mt-1 font-serif text-lg text-[color:var(--color-ink)]">~ 780</dd>
        </div>
        <div class="hidden sm:block">
          <dt class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Landkreis</dt>
          <dd class="mt-1 font-serif text-lg text-[color:var(--color-ink)]">Schweinfurt</dd>
        </div>
        <div class="hidden sm:block">
          <dt class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Koordinate</dt>
          <dd class="mt-1 font-serif text-lg text-[color:var(--color-ink)]">50,01° N</dd>
        </div>
      </dl>

      <a href="#der-ort" class="hero-enter group flex flex-col items-center gap-3 text-[11px] uppercase tracking-[0.24em] text-[color:var(--color-muted)] transition-colors hover:text-[color:var(--color-sandstone)]" style="--enter-delay:760ms" aria-label="Weiter zum Inhalt">
        <span class="hidden sm:inline">Hinab</span>
        <span class="block h-12 w-px bg-[color:var(--color-line-strong)] transition-all group-hover:bg-[color:var(--color-sandstone)]">
          <span class="block h-3 w-px translate-y-0 animate-[scroll-hint_2.2s_ease-in-out_infinite] bg-[color:var(--color-sandstone)]"></span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes scroll-hint {
    0%   { transform: translateY(-12px); opacity: 0; }
    50%  { opacity: 1; }
    100% { transform: translateY(48px); opacity: 0; }
  }

  /* Aerial photograph of the village, washed into the paper so it reads like
     a pressed image on newsprint rather than a stock hero banner. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -10;
    overflow: hidden;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    opacity: 0.32;
    filter: saturate(0.68) contrast(1.02) sepia(0.1);
    mix-blend-mode: multiply;
    transform: scale(1.08);
  }

  /* Fade the photo into paper at the edges and protect the headline side. */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(250 248 245 / 0.72) 0%, rgb(250 248 245 / 0) 26%, rgb(250 248 245 / 0) 50%, rgb(250 248 245 / 0.86) 86%, var(--color-paper) 100%),
      linear-gradient(90deg, rgb(250 248 245 / 0.82) 0%, rgb(250 248 245 / 0.2) 52%, rgb(250 248 245 / 0) 78%),
      radial-gradient(120% 90% at 8% 92%, rgb(154 106 61 / 0.06), transparent 60%);
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-bg-img {
        animation: hero-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
        will-change: transform;
      }
    }
  }

  @keyframes hero-zoom {
    from { transform: scale(1.08) translateY(0); }
    to   { transform: scale(1.18) translateY(2.5%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img { transform: scale(1.05); }
  }
</style>
