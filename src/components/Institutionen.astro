---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import instSv from "../assets/images/inst-sv.jpg";
import instSchlossmuehle from "../assets/images/inst-schlossmuehle.jpg";
import instStGallus from "../assets/images/inst-st-gallus.jpg";
import instMainsteg from "../assets/images/mainsteg-untereuerheim.jpg";

type Inst = {
  name: string;
  meta: string;
  description: string;
  href: string;
  hrefLabel: string;
  image: ImageMetadata;
  imageAlt: string;
};

const institutionen: Inst[] = [
  {
    name: "SV 1945 Untereuerheim",
    meta: "Sportverein. Gegründet 1945.",
    description: "Sportverein mit Abteilungen für Fußball, Gymnastik und Tischtennis. Vereinsheim und Sommerfest am Eurumer Waldspielplatz.",
    href: "https://sv-untereuerheim.de",
    hrefLabel: "sv-untereuerheim.de",
    image: instSv,
    imageAlt: "Eingang zum Eurumer Waldspielplatz mit Biergarten des SV Untereuerheim.",
  },
  {
    name: "Schlossmühle Untereuerheim",
    meta: "In Betrieb seit dem 16. Jahrhundert.",
    description: "Eine der ältesten arbeitenden Mühlen der Region. Verkauf von Mehl, Schrot und regionalen Erzeugnissen direkt ab Hof.",
    href: "https://schlossmuehle-untereuerheim.de",
    hrefLabel: "schlossmuehle-untereuerheim.de",
    image: instSchlossmuehle,
    imageAlt: "Die Schlossmühle Untereuerheim, ein Fachwerkbau mit rotem Ziegeldach.",
  },
  {
    name: "Pfarrei St. Gallus",
    meta: "Bistum Würzburg.",
    description: "Pfarrei mit Kirche aus dem 16. Jahrhundert. Regelmäßige Gottesdienste und die jährliche Wallfahrt nach Dettelbach.",
    href: "https://st-gallus-st-laurentius.com",
    hrefLabel: "st-gallus-st-laurentius.com",
    image: instStGallus,
    imageAlt: "Die Pfarrkirche St. Gallus mit ihrem spitzen Kirchturm und das Wegkreuz davor.",
  },
  {
    name: "Mainbrückenverein Untereuerheim",
    meta: "Verein zum Erhalt des Mainstegs.",
    description: "Trägerverein des Mainstegs zwischen Untereuerheim und Obereuerheim. Sammelt Spenden für Unterhalt und Sanierung der Brücke.",
    href: "https://www.mainbrueckenvereinuntereuerheim.de",
    hrefLabel: "mainbrueckenvereinuntereuerheim.de",
    image: instMainsteg,
    imageAlt: "Der Mainsteg bei Untereuerheim, eine schlanke Bogenbrücke über den Main.",
  },
];

const weiterfuehrend = [
  {
    name: "KÖB Untereuerheim",
    description: "Katholische Öffentliche Bücherei am Ort.",
    href: "http://www.koeb.untereuerheim.de",
    hrefLabel: "koeb.untereuerheim.de",
  },
  {
    name: "Kriegerdenkmal",
    description: "Dokumentation des Denkmals auf denkmalprojekt.org.",
    href: "http://www.denkmalprojekt.org/2017/untereuerheim_gde_grettstad_lk-schweinfurt_bay.html",
    hrefLabel: "denkmalprojekt.org",
  },
];
---
<section id="institutionen" class="relative scroll-mt-24 py-28 sm:py-36">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="mb-4 font-sans text-[11px] uppercase tracking-[0.28em] text-[color:var(--color-muted)]">
        Drei. Institutionen
      </p>
      <h2 class="font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl">
        Institutionen im Ort.
      </h2>
      <p class="mt-5 font-serif text-lg italic text-[color:var(--color-ink-soft)]">
        Sportverein, Mühle, Pfarrei und Brückenverein.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
      {institutionen.map((inst) => (
        <a
          href={inst.href}
          rel="external noopener"
          target="_blank"
          class="reveal group relative flex flex-col overflow-hidden rounded-2xl bg-[color:var(--color-paper-2)]/85 ring-1 ring-[color:var(--color-line)] transition-all duration-500 hover:-translate-y-1 hover:bg-[color:var(--color-paper-2)] hover:shadow-[var(--shadow-soft)] hover:ring-[color:var(--color-line-strong)]"
        >
          <div class="relative aspect-[4/3] w-full overflow-hidden">
            <Image
              src={inst.image}
              alt={inst.imageAlt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 280px, (min-width: 768px) 360px, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            />
          </div>

          <div class="flex flex-1 flex-col p-7">
            <h3 class="font-serif text-2xl leading-tight">{inst.name}</h3>
            <p class="mt-2 text-[12px] uppercase tracking-[0.18em] text-[color:var(--color-muted)]">{inst.meta}</p>
            <p class="mt-5 text-[15px] leading-relaxed text-[color:var(--color-ink-soft)]">{inst.description}</p>

            <span class="mt-8 inline-flex items-center gap-2 text-[13px] text-[color:var(--color-sandstone)]">
              <span class="link-underline">{inst.hrefLabel}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                <path d="M7 17 17 7"/>
                <path d="M8 7h9v9"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="reveal mt-20 border-t border-[color:var(--color-line)] pt-12 sm:mt-24 sm:pt-14">
      <p class="mb-6 font-sans text-[11px] uppercase tracking-[0.28em] text-[color:var(--color-muted)]">
        Weiterführend
      </p>
      <ul class="grid grid-cols-1 gap-x-10 gap-y-6 sm:grid-cols-2">
        {weiterfuehrend.map((item) => (
          <li>
            <a
              href={item.href}
              rel="external noopener"
              target="_blank"
              class="group block"
            >
              <p class="font-serif text-xl leading-tight text-[color:var(--color-ink)]">
                {item.name}
              </p>
              <p class="mt-2 text-[14.5px] leading-relaxed text-[color:var(--color-ink-soft)]">
                {item.description}
              </p>
              <span class="mt-3 inline-flex items-center gap-2 text-[13px] text-[color:var(--color-sandstone)]">
                <span class="link-underline">{item.hrefLabel}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                  <path d="M7 17 17 7"/>
                  <path d="M8 7h9v9"/>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
