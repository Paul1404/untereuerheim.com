---
import { Image } from "astro:assets";
import { getInstitutionPath, institutionen } from "../data/institutionen";
---
<section id="institutionen" class="relative scroll-mt-24 py-28 sm:py-36">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="reveal relative isolate mx-auto max-w-3xl text-center">
      <span aria-hidden="true" class="ghost-numeral left-1/2 -top-12 -translate-x-1/2 text-[9rem] sm:text-[12rem]">03</span>
      <p class="mb-4 font-sans text-[11px] uppercase tracking-[0.28em] text-[color:var(--color-muted)]">
        Drei. Institutionen
      </p>
      <h2 class="font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl">
        Institutionen im Ort.
      </h2>
      <p class="mt-5 font-serif text-lg italic text-[color:var(--color-ink-soft)]">
        Vereine, Mühle, Pfarrei, Bücherei und Denkmal.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 md:gap-8 lg:grid-cols-3">
      {institutionen.map((inst) => (
        <a
          href={getInstitutionPath(inst)}
          class="reveal group relative flex flex-col overflow-hidden rounded-[1.35rem] bg-[color:var(--color-paper-2)]/85 ring-1 ring-[color:var(--color-line)] transition-all duration-500 hover:-translate-y-1.5 hover:bg-[color:var(--color-paper-2)] hover:shadow-[var(--shadow-card)] hover:ring-[color:var(--color-sandstone-soft)]"
        >
          <div class="relative aspect-[4/3] w-full overflow-hidden">
            <Image
              src={inst.image}
              alt={inst.imageAlt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[color:var(--color-ink)]/20 via-transparent to-transparent opacity-60 transition-opacity group-hover:opacity-30"></div>
            <span class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-white/45 bg-[color:var(--color-paper)]/75 text-[color:var(--color-sandstone)] shadow-sm backdrop-blur-md transition-transform duration-500 group-hover:rotate-45">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </span>
          </div>

          <div class="flex flex-1 flex-col p-7">
            <h3 class="font-serif text-2xl leading-tight">{inst.name}</h3>
            <p class="mt-2 text-[12px] uppercase tracking-[0.18em] text-[color:var(--color-muted)]">{inst.meta}</p>
            <p class="mt-5 text-[15px] leading-relaxed text-[color:var(--color-ink-soft)]">{inst.description}</p>

            <span class="mt-8 inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-[color:var(--color-sandstone)]">
              <span class="link-underline break-all">Lokales Profil ansehen</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                <path d="M7 17 17 7"/>
                <path d="M8 7h9v9"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
