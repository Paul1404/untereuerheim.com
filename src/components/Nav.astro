---
const links = [
  { href: "/#der-ort", label: "Der Ort" },
  { href: "/#chronik", label: "Chronik" },
  { href: "/#institutionen", label: "Institutionen" },
  { href: "/archiv", label: "Archiv" },
];
---
<header class="fixed inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-8 sm:py-5">
    <a href="/" class="group flex items-center gap-2.5 text-[color:var(--color-ink)]">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-[color:var(--color-sandstone)] font-serif text-[15px] italic leading-none text-[color:var(--color-paper)] shadow-[var(--shadow-soft)]">U</span>
      <span class="font-serif text-[15px] tracking-wide">Untereuerheim</span>
    </a>
    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-7 text-[13px] tracking-wide text-[color:var(--color-ink-soft)]">
        {links.map((l) => (
          <li>
            <a href={l.href} class="link-underline transition-colors hover:text-[color:var(--color-sandstone)]">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-24 bg-gradient-to-b from-[color:var(--color-paper)]/95 via-[color:var(--color-paper)]/80 to-transparent backdrop-blur-[2px]"></div>
</header>
