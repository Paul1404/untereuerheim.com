---
import "../styles/global.css";
import cormorant500 from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url";
import cormorant500Italic from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Untereuerheim. Ortsteil von Grettstadt im Landkreis Schweinfurt.",
  description = "Untereuerheim (PLZ 97508), Ortsteil von Grettstadt im Landkreis Schweinfurt. Am rechten Ufer des Mains zwischen Schweinfurt und Haßfurt. Rund 780 Einwohner. Erstmals urkundlich erwähnt um das Jahr 800. Pfarrei St. Gallus, Schlossmühle, Mainsteg nach Obereuerheim.",
  image = "/og.jpg",
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("/", Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage = new URL(image, siteOrigin).toString();

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

const placeId = new URL("#untereuerheim", siteOrigin).toString();
const websiteId = new URL("#website", siteOrigin).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteOrigin.toString(),
      name: "Untereuerheim",
      inLanguage: "de-DE",
      description,
      publisher: { "@id": placeId },
    },
    {
      "@type": "Place",
      "@id": placeId,
      name: "Untereuerheim",
      alternateName: "Ortsteil Untereuerheim",
      description:
        "Untereuerheim ist ein Ortsteil der Gemeinde Grettstadt im Landkreis Schweinfurt in Unterfranken, Bayern. Der Ort liegt am rechten Ufer des Mains zwischen Schweinfurt und Haßfurt. Postleitzahl 97508. Rund 780 Einwohner. Erstmals urkundlich erwähnt um das Jahr 800.",
      url: siteOrigin.toString(),
      image: ogImage,
      geo: {
        "@type": "GeoCoordinates",
        latitude: 50.01344,
        longitude: 10.35615,
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Untereuerheim",
        addressRegion: "BY",
        postalCode: "97508",
        addressCountry: "DE",
      },
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Grettstadt",
        address: {
          "@type": "PostalAddress",
          postalCode: "97508",
          addressRegion: "BY",
          addressCountry: "DE",
        },
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "Landkreis Schweinfurt",
          address: {
            "@type": "PostalAddress",
            addressRegion: "BY",
            addressCountry: "DE",
          },
        },
      },
      sameAs: ["https://de.wikipedia.org/wiki/Untereuerheim"],
    },
    {
      "@type": "SportsOrganization",
      "@id": new URL("#sv", siteOrigin).toString(),
      name: "SV 1945 Untereuerheim",
      foundingDate: "1945",
      url: "https://sv-untereuerheim.de",
      areaServed: { "@id": placeId },
    },
    {
      "@type": "LocalBusiness",
      "@id": new URL("#schlossmuehle", siteOrigin).toString(),
      name: "Schlossmühle Untereuerheim",
      description:
        "Mühle in Betrieb seit dem 16. Jahrhundert. Verkauf von Mehl, Schrot und regionalen Erzeugnissen.",
      url: "https://schlossmuehle-untereuerheim.de",
      containedInPlace: { "@id": placeId },
    },
    {
      "@type": "Church",
      "@id": new URL("#st-gallus", siteOrigin).toString(),
      name: "Pfarrei St. Gallus",
      description:
        "Pfarrei und Kirche St. Gallus in Untereuerheim, Bistum Würzburg. Kirchturm aus der Echter-Zeit, Taufstein von 1592.",
      url: "https://st-gallus-st-laurentius.com",
      containedInPlace: { "@id": placeId },
    },
    {
      "@type": "Organization",
      "@id": new URL("#mainbrueckenverein", siteOrigin).toString(),
      name: "Mainbrückenverein Untereuerheim",
      description:
        "Trägerverein des Mainstegs zwischen Untereuerheim und Obereuerheim.",
      url: "https://www.mainbrueckenvereinuntereuerheim.de",
      areaServed: { "@id": placeId },
    },
  ],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#faf8f5" />

    <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorant500Italic} as="font" type="font/woff2" crossorigin />

    <meta name="geo.region" content="DE-BY" />
    <meta name="geo.placename" content="Untereuerheim, Grettstadt" />
    <meta name="geo.position" content="50.01344;10.35615" />
    <meta name="ICBM" content="50.01344, 10.35615" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Untereuerheim" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luftbild von Untereuerheim am rechten Mainufer mit der Pfarrkirche St. Gallus." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Luftbild von Untereuerheim am rechten Mainufer mit der Pfarrkirche St. Gallus." />

    {isHome && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#hauptinhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-[color:var(--color-ink)] focus:px-3 focus:py-2 focus:text-[color:var(--color-paper)]"
    >
      Zum Inhalt
    </a>
    <slot />

    <script>
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if (!("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
