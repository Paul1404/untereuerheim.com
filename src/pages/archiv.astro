    id: "D-6-78-138-73",
  },
  {
    address: "Brunnenstraße 11",
    year: "1798",
    description: "Torbogen mit Nepomukfigur und Putti.",
    id: "D-6-78-138-74",
  },
  {
    address: "Fischgasse 2",
    year: "1850",
    description: "Kreuzigungsgruppe mit Relief Christus am Ölberg, Sandstein.",
