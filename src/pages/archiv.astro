---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

type Denkmal = {
  address: string;
  year: string;
  description: string;
  id: string;
};

const baudenkmaeler: Denkmal[] = [
  {
    address: "Brunnenstraße 8",
    year: "18. Jh.",
    description: "Hoftor mit Fußgängerpforte, Sitznischen und Radabweisern.",
    id: "D-6-78-138-73",
  },
  {
    address: "Brunnenstraße 11",
    year: "1798",
    description: "Torbogen mit Nepomukfigur und Putti.",
    id: "D-6-78-138-74",
  },
  {
    address: "Fischgasse 2",
    year: "1850",
    description: "Kreuzigungsgruppe mit Relief Christus am Ölberg, Sandstein.",
    id: "D-6-78-138-76",
  },
  {
    address: "Hintere Gasse 2",
    year: "1840",
    description: "Hoftor mit Fußgängerpforte und Vasen-Bekrönung.",
    id: "D-6-78-138-77",
  },
  {
    address: "Immenrot 2",
    year: "1750",
    description: "Bildstock mit Tischsockel und Relief der Marienkrönung.",
    id: "D-6-78-138-93",
  },
  {
    address: "Lindenstraße 4",
    year: "1775 / 1857",
    description: "Torbogen mit Radabweisern und Kugelaufsatz, dazu eine Kreuzigungsgruppe von 1857.",
    id: "D-6-78-138-79",
  },
  {
    address: "Mühlgasse 7",
    year: "1720",
    description: "Torbogen mit Radabweisern, Fußgängerpforte mit Bänken und Kugelaufsätzen.",
    id: "D-6-78-138-80",
  },
  {
    address: "Beim Eichenweg",
    year: "1628",
    description: "Bildstock mit Rundschaft und Relief der Marienkrönung.",
    id: "D-6-78-138-75",
  },
  {
    address: "Bei der Obereuerheimer Straße",
    year: "1850",
    description: "Bildstock.",
    id: "D-6-78-138-78",
  },
  {
    address: "Friedhof am Schweinfurter Weg",
    year: "1850",
    description: "Zwei Friedhofskreuze mit Marienfiguren.",
    id: "D-6-78-138-94",
  },
];

type TafelMeta = {
  no: string;
  href: string;
  label: string;
  era: string;
};

const tafeln: TafelMeta[] = [
  { no: "I",    href: "#mittelalter",   label: "Mittelalter und Grundherren", era: "9.–14. Jh." },
  { no: "II",   href: "#pest",          label: "Die Pest und das Gelübde",    era: "1585" },
  { no: "III",  href: "#st-gallus",     label: "St. Gallus",                  era: "um 1600" },
  { no: "IV",   href: "#schlossmuehle", label: "Die Schlossmühle",            era: "16. Jh." },
  { no: "V",    href: "#baudenkmaeler", label: "Bildstöcke, Tore und Wegkreuze", era: "Denkmalliste" },
  { no: "VI",   href: "#stufenlinde",   label: "Die Stufenlinde",             era: "Lindenstraße" },
  { no: "VII",  href: "#mainsteg",      label: "Fähre und Mainsteg",          era: "seit 1384" },
  { no: "VIII", href: "#verkehr",       label: "Verkehr und Lage",            era: "heute" },
  { no: "IX",   href: "#kriegerdenkmal",label: "Kriegergedenkkapelle",        era: "1914 / 1939" },
  { no: "X",    href: "#quellen",       label: "Quellen",                     era: "Belege" },
];

type Quelle = { label: string; href: string };

const quellen: Quelle[] = [
  { label: "Untereuerheim – Wikipedia", href: "https://de.wikipedia.org/wiki/Untereuerheim" },
  { label: "Obereuerheim – Wikipedia", href: "https://de.wikipedia.org/wiki/Obereuerheim" },
  { label: "St. Gallus (Untereuerheim) – Wikipedia", href: "https://de.wikipedia.org/wiki/St._Gallus_(Untereuerheim)" },
  { label: "Liste der Baudenkmäler in Grettstadt – Wikipedia", href: "https://de.wikipedia.org/wiki/Liste_der_Baudenkm%C3%A4ler_in_Grettstadt" },
  { label: "Gemeinde Grettstadt – Untereuerheim", href: "https://www.grettstadt.de/verzeichnis/visitenkarte.php?mandat=170135" },
  { label: "Gemeinde Grettstadt – Obereuerheim", href: "https://www.grettstadt.de/verzeichnis/visitenkarte.php?mandat=170134" },
  { label: "Mainbrückenverein Untereuerheim", href: "https://www.mainbrueckenvereinuntereuerheim.de" },
  { label: "Mainbrückenverein – Geschichte", href: "http://www.mainbrueckenverein.untereuerheim.de/ueber_uns.htm" },
  { label: "Schlossmühle Untereuerheim", href: "https://schlossmuehle-untereuerheim.de" },
  { label: "Kriegergedenkkapelle Untereuerheim – denkmalprojekt.org", href: "http://www.denkmalprojekt.org/2017/untereuerheim_gde_grettstad_lk-schweinfurt_bay.html" },
  { label: "Chronik – untereuerheim.de", href: "http://www.untereuerheim.de/chronik.htm" },
  { label: "Stufenlinde Untereuerheim – baumkunde.de", href: "https://www.baumkunde.de/baumregister/7779-stufenlinde_untereuerheim/" },
  { label: "Bayerischer Denkmal-Atlas", href: "https://geoportal.bayern.de/denkmalatlas/" },
];
---
<Base
  title="Archiv. Was wir über Untereuerheim wissen."
  description="Ausführliche Sammlung zu Untereuerheim (97508). Mittelalter und Grundherren, Pestgelübde von 1585, Kuratiekirche St. Gallus mit Julius-Echter-Turm um 1600, Schlossmühle aus dem 16. Jahrhundert, Bildstöcke und Wegkreuze, Stufenlinde in der Lindenstraße, Mainsteg nach Gädheim und Ottendorf seit 1384, Kriegergedenkkapelle und Verkehrsanbindung an A 70, B 303 und St 2277."
>
  <Nav />
  <main id="hauptinhalt">

    <!-- COVER -->
    <section class="relative">
      <div class="mx-auto max-w-5xl px-6 pt-36 pb-10 sm:px-8 sm:pt-48 sm:pb-16">
        <div class="reveal">
          <p class="mb-6 inline-flex items-center gap-3 font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
            <span class="h-px w-10 bg-[color:var(--color-line-strong)]"></span>
            Zehn Abschnitte
          </p>
          <h1 class="font-serif text-[clamp(3.5rem,11vw,9rem)] leading-[0.88] tracking-[-0.025em] text-[color:var(--color-ink)]">
            Archiv<span class="text-[color:var(--color-sandstone)]">.</span>
          </h1>
          <p class="mt-10 max-w-xl text-balance font-serif text-[clamp(1.2rem,2vw,1.55rem)] italic leading-[1.3] text-[color:var(--color-ink-soft)]">
            Was über Untereuerheim aus öffentlichen Quellen belegt ist.
          </p>
          <p class="mt-8 max-w-md text-[14px] leading-relaxed text-[color:var(--color-muted)]">
            Untereuerheim, PLZ 97508. Ortsteil der Gemeinde Grettstadt, Landkreis Schweinfurt, am rechten Ufer des Mains. Die Hauptseite gibt die kurze Fassung, diese Seite die ausführliche.
          </p>
        </div>

        <div class="reveal mt-20 ornament">
          <span class="ornament-glyph"></span>
        </div>
      </div>
    </section>

    <!-- INDEX (Tafeln) -->
    <section class="reveal mx-auto max-w-5xl px-6 sm:px-8">
      <p class="mb-4 font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">Index</p>
      <ol class="mt-6 rule-top">
        {tafeln.map((t) => (
          <li class="grid grid-cols-[3rem_1fr_auto] items-baseline gap-x-5 gap-y-1 border-b border-[color:var(--color-line)] py-5 sm:grid-cols-[4rem_1fr_10rem] sm:gap-x-8 sm:py-6">
            <span class="font-serif text-base italic tracking-wide text-[color:var(--color-muted)] sm:text-lg">{t.no}</span>
            <a
              href={t.href}
              class="link-underline font-serif text-[clamp(1.05rem,2vw,1.45rem)] text-[color:var(--color-ink)] transition-colors hover:text-[color:var(--color-sandstone)]"
            >
              {t.label}
            </a>
            <span class="col-start-2 sm:col-start-3 sm:text-right font-sans text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">
              {t.era}
            </span>
          </li>
        ))}
      </ol>
    </section>

    <!-- TAFEL I — MITTELALTER -->
    <article class="mx-auto mt-32 max-w-5xl px-6 sm:mt-44 sm:px-8">

      <section id="mittelalter" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel I &nbsp;·&nbsp; Mittelalter
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              800
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Erste urkundliche Spuren in den Klosterbüchern von Fulda und Sankt Stephan in Würzburg. Die Datierung schwankt zwischen 800 und 880.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Mittelalter und Grundherren.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                Der Name <em>Uraheim</em> taucht erstmals in den Urkundenbüchern der Klöster Fulda und Sankt Stephan in Würzburg auf. Die Datierung schwankt zwischen 800 und 880. Zu dieser Zeit gibt es noch keinen getrennten Ober- und Unterort.
              </p>
              <p>
                Im 12. Jahrhundert ist in einer Würzburger Urkunde von einem <em>obern Uraheim</em> die Rede, was die Existenz eines Unterorts impliziert.
              </p>
              <p>
                Im 13. Jahrhundert trennt sich der Name endgültig in Ober- und Untereuerheim. In den folgenden Jahrhunderten wechseln sich das Zisterzienserkloster Ebrach, das Hochstift Würzburg und die Grafen von Henneberg als Grundherren ab. Am 1. Mai 1978 wird Untereuerheim im Zuge der bayerischen Gebietsreform nach Grettstadt eingemeindet.
              </p>
            </div>

            <dl class="mt-12 grid grid-cols-1 gap-x-8 gap-y-3 rule-top border-b border-[color:var(--color-line)] py-6 text-[14px] sm:grid-cols-2">
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">um 800</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Erstmals als <em>Uraheim</em> belegt</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">13. Jh.</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Trennung in <em>obern</em> und <em>untern</em> Uraheim</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1320</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Erste Mühle (Maria Burghausen) belegt</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1571</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Baubeginn Schloss Euerburg (Obereuerheim)</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1978</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Eingemeindung nach Grettstadt</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <!-- Pull quote -->
      <div class="reveal mt-32 mb-32 sm:mt-40 sm:mb-40">
        <div class="ornament mb-12"><span class="ornament-glyph"></span></div>
        <blockquote class="pull-quote mx-auto max-w-3xl text-center">
          219 Einwohner sterben zwischen Juni und November 1585 an der Pest.
        </blockquote>
        <p class="mt-6 text-center font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">1585</p>
      </div>

      <!-- TAFEL II — PEST -->
      <section id="pest" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel II &nbsp;·&nbsp; Pest und Gelübde
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              219
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Tote vom 29. Juni bis 11. November 1585. Zwei Tafeln an der Kirchhofmauer von St. Gallus erinnern bis heute daran.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Die Pest von 1585 und das Gelübde.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                Zwischen dem Fest Peter und Paul am 29. Juni 1585 und dem Martinstag am 11. November desselben Jahres sterben 219 Einwohner Untereuerheims an der Pest. In ihrer Not legen die Überlebenden ein Gelübde ab.
              </p>
              <p>
                Sie verpflichten sich zur jährlichen Wallfahrt nach Dettelbach, zur Wallfahrtskirche Maria im Sand am linken Mainufer. Die Wallfahrt findet seit über 400 Jahren alljährlich statt.
              </p>
            </div>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL III — ST. GALLUS -->
      <section id="st-gallus" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel III &nbsp;·&nbsp; Pfarrkirche
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              1600
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Julius-Echter-Turm im Osten, dreiseitig geschlossener Chor im Westen, neugotisches Langhaus aus dem 19. Jahrhundert dazwischen.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              St. Gallus.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                St. Gallus ist die römisch-katholische Kuratiekirche Untereuerheims. Sie gehört zur Pfarreiengemeinschaft St. Christophorus im Mainbogen mit Sitz in Gochsheim, im Dekanat Schweinfurt-Nord des Bistums Würzburg.
              </p>
              <p>
                Eine Saalkirche aus drei Teilen. Der Julius-Echter-Turm im Osten entstand um 1600 und trägt einen achtseitigen, schiefergedeckten Knickhelm. Der dreiseitig geschlossene Chor schließt im Westen an. Das neugotische Langhaus dazwischen wurde in der zweiten Hälfte des 19. Jahrhunderts errichtet.
              </p>
            </div>

            <dl class="mt-12 grid grid-cols-1 gap-x-8 gap-y-3 rule-top border-b border-[color:var(--color-line)] py-6 text-[14px] sm:grid-cols-2">
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1592</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Taufstein (Echter-Zeit)</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">um 1600</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Julius-Echter-Turm</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">19. Jh.</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Neugotisches Langhaus</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1850</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Orgel, 10 Register, 1 Manual, 1 Pedal</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1979</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Instandsetzung, Ausmalung um 1900</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1988</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Orgelrestaurierung, Horst Hoffmann</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL IV — SCHLOSSMÜHLE -->
      <section id="schlossmuehle" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel IV &nbsp;·&nbsp; Mühle
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(4.5rem,9vw,7rem)]">
              16. Jh.
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Schloßmühlenweg 2. Im 16. Jahrhundert errichtet, bis heute in Betrieb.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Die Schlossmühle.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                Die Schlossmühle stammt aus dem 16. Jahrhundert. Sie gehörte ursprünglich zum Schloss Euerburg im benachbarten Obereuerheim, daher ihr Name. Heute betreibt sie Jochen Schor (e. K.) am Schloßmühlenweg 2.
              </p>
              <p>
                Der Mühlenladen bietet eigene Mehle, Getreide und regionale Produkte an.
              </p>
              <p class="marginalia">
                Bereits 1320 ist eine andere, frühere Mühle in Untereuerheim urkundlich belegt. Sie gehörte dem Konvent von Maria Burghausen. Ob beide Mühlen am selben Standort lagen, ist nicht überliefert.
              </p>
            </div>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL V — DENKMALLISTE -->
      <section id="baudenkmaeler" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel V &nbsp;·&nbsp; Denkmalliste
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              10
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Bau- und Kleindenkmäler nach dem Bayerischen Landesamt für Denkmalpflege. Tore, Bildstöcke, Wegkreuze.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Bildstöcke, Tore und Wegkreuze.
            </h2>
            <p class="mt-8 max-w-2xl text-[15px] leading-relaxed text-[color:var(--color-ink-soft)]">
              In der bayerischen Denkmalliste sind für Untereuerheim folgende Bau- und Kleindenkmäler eingetragen.
            </p>
          </div>
        </div>

        <ol class="mt-14 divide-y divide-[color:var(--color-line)] border-y border-[color:var(--color-line)]">
          {baudenkmaeler.map((d) => (
            <li class="grid grid-cols-1 gap-x-8 gap-y-2 py-6 sm:grid-cols-[8rem_1fr_10rem]">
              <span class="font-serif text-2xl italic text-[color:var(--color-sandstone)] tabular-nums">{d.year}</span>
              <div>
                <p class="font-serif text-lg text-[color:var(--color-ink)]">{d.address}</p>
                <p class="mt-1.5 text-[14.5px] leading-relaxed text-[color:var(--color-ink-soft)]">{d.description}</p>
              </div>
              <span class="font-sans text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)] sm:text-right sm:self-start">
                {d.id}
              </span>
            </li>
          ))}
        </ol>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL VI — STUFENLINDE -->
      <section id="stufenlinde" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel VI &nbsp;·&nbsp; Linde
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              IV
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Stockwerke im Baumkataster. Stufenlinden wurden traditionell als Tanz-, Gerichts- oder Versammlungslinden gezogen. Heute selten.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Die Stufenlinde.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                Die Stufenlinde steht in der Lindenstraße. Sie ist eine Winterlinde, in mehreren Etagen gezogen, im Baumkataster mit vier Stockwerken erfasst und auf etwa hundert Jahre geschätzt.
              </p>
              <p>
                Am Anwesen Lindenstraße 4 stehen außerdem ein Torbogen mit Radabweisern und Kugelaufsatz aus dem Jahr 1775 sowie eine Kreuzigungsgruppe von 1857.
              </p>
              <p class="marginalia">
                Quelle Standort: baumkunde.de, Baumregister 7779.
              </p>
            </div>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL VII — MAINSTEG -->
      <section id="mainsteg" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel VII &nbsp;·&nbsp; Mainquerung
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              1384
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Seit 1384 urkundlich als Fähre belegt. Über Jahrhunderte hatte der Ort Fischer, Schiffer und einen Fährmann.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Fähre und Mainsteg.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                An der heutigen Stelle des Mainstegs ist seit 1384 eine Fähre belegt. Sie verband das rechte Ufer mit Gädheim und Ottendorf im heutigen Landkreis Haßberge.
              </p>
              <p>
                1963 wurde der Fährbetrieb wegen des Mainausbaus eingestellt. Die damals noch selbstständige Gemeinde Untereuerheim wollte auf die Mainverbindung nicht verzichten und finanzierte aus eigener Kraft den Bau eines Stegs. Seit 1967 verbindet er die Ufer als Fußgängerbrücke.
              </p>
              <p class="note-rail font-serif italic text-[color:var(--color-ink-soft)]">
                Der Steg steht bis heute. Über einen Ersatzneubau wird seit Längerem diskutiert. Der 2011 gegründete Mainbrückenverein sammelt Spenden für die Zukunft der Mainquerung.
              </p>
            </div>

            <dl class="mt-12 grid grid-cols-1 gap-x-8 gap-y-3 rule-top border-b border-[color:var(--color-line)] py-6 text-[14px] sm:grid-cols-2">
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1384</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Fähre urkundlich belegt</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1963</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Fährbetrieb eingestellt</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">1967</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Mainsteg als Fußgängerbrücke</dd>
              </div>
              <div class="flex items-baseline gap-4">
                <dt class="font-serif text-[color:var(--color-sandstone)] tabular-nums w-20">2011</dt>
                <dd class="text-[color:var(--color-ink-soft)]">Mainbrückenverein gegründet</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL VIII — VERKEHR & LAGE -->
      <section id="verkehr" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel VIII &nbsp;·&nbsp; Lage
            </p>
            <div class="numeral-anchor mt-8 tabular-nums text-[clamp(2rem,4.4vw,3.2rem)] leading-[1.1]">
              50.0136°N<br>10.3547°O
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              223 m über NHN. Gemarkung 5,48 km². Zwischen Schweinfurt im Westen und Haßfurt im Osten.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Verkehr und Lage.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                Untereuerheim liegt 223 Meter über dem Meer am rechten Mainufer, zwischen Schweinfurt im Westen und Haßfurt im Osten. Die Gemarkung misst 5,48 Quadratkilometer.
              </p>
              <p>
                Südlich des Ortes verläuft in Ost-West-Richtung die Bundesautobahn A 70 zwischen den Anschlussstellen Schonungen und Haßfurt. Der Abschnitt Schonungen–Haßfurt wurde am 28. Oktober 1992 freigegeben. Nördlich verläuft, ebenfalls in Ost-West-Richtung, die Bundesstraße B 303. Die Staatsstraße St 2277 führt westwärts nach Weyer und südwärts nach Obereuerheim. Über den Mainsteg ist Ottendorf (Gemeinde Gädheim, Landkreis Haßberge) fußläufig erreichbar.
              </p>
            </div>

            <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-5 rule-top border-b border-[color:var(--color-line)] py-6 sm:grid-cols-3">
              <div class="flex flex-col gap-1">
                <dt class="text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">PLZ</dt>
                <dd class="font-serif text-xl text-[color:var(--color-ink)]">97508</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">Vorwahl</dt>
                <dd class="font-serif text-xl text-[color:var(--color-ink)]">09729</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">Kfz</dt>
                <dd class="font-serif text-xl text-[color:var(--color-ink)]">SW</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">Höhe</dt>
                <dd class="font-serif text-xl text-[color:var(--color-ink)]">223 m</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">Fläche</dt>
                <dd class="font-serif text-xl text-[color:var(--color-ink)]">5,48 km²</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-muted)]">Einwohner</dt>
                <dd class="font-serif text-xl text-[color:var(--color-ink)]">786 <span class="text-[12px] text-[color:var(--color-muted)]">(2020)</span></dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL IX — KRIEGERDENKMAL -->
      <section id="kriegerdenkmal" class="reveal scroll-mt-24">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel IX &nbsp;·&nbsp; Gedenkort
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(2.4rem,5vw,3.6rem)] leading-[1.1]">
              1914<br>1939
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              An der Einmündung des Schloßmühlenwegs in die Obereuerheimer Straße. Beide Weltkriege sind dokumentiert.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Kriegergedenkkapelle.
            </h2>
            <div class="mt-10 space-y-6 text-[16px] leading-[1.78] text-[color:var(--color-ink-soft)] sm:text-[17px]">
              <p class="dropcap">
                Die Kriegergedenkkapelle steht an der Einmündung des Schloßmühlenwegs in die Obereuerheimer Straße. An der Rückwand befindet sich ein Kreuz zwischen zwei steinernen Namensplatten. Eine davon trägt die Inschrift <em>Die Heimat ihren gefallenen Söhnen</em>, eine zweite <em>Unsere Vermißten</em>.
              </p>
              <p>
                An der linken Wand hängt ein Wandbild mit der Kriegschronik 1914 bis 1918 des örtlichen Krieger- und Veteranenvereins.
              </p>
              <p class="marginalia">
                Die vollständige Liste der Namen ist auf denkmalprojekt.org dokumentiert. Der Link steht unten in den Quellen.
              </p>
            </div>
          </div>
        </div>
      </section>

      <div class="ornament my-28 sm:my-36"><span class="ornament-glyph"></span></div>

      <!-- TAFEL X — QUELLEN -->
      <section id="quellen" class="reveal scroll-mt-24 pb-20 sm:pb-28">
        <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
          <aside class="lg:col-span-4">
            <p class="font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
              Tafel X &nbsp;·&nbsp; Belege
            </p>
            <div class="numeral-anchor mt-8 text-[clamp(5.5rem,12vw,9rem)]">
              {quellen.length}
            </div>
            <p class="marginalia mt-6 max-w-[20ch]">
              Wikipedia, Bayerisches Landesamt für Denkmalpflege, baumkunde.de und die Vereine vor Ort.
            </p>
          </aside>

          <div class="lg:col-span-8">
            <h2 class="font-serif text-[clamp(2rem,3.6vw,3rem)] leading-[1.05] tracking-tight">
              Quellen.
            </h2>
            <p class="mt-8 max-w-2xl text-[15px] leading-relaxed text-[color:var(--color-ink-soft)]">
              Alles auf dieser Seite ist anderswo nachzulesen. Hier die Bezugsstellen.
            </p>

            <ol class="mt-10 rule-top">
              {quellen.map((q, i) => (
                <li class="grid grid-cols-[2rem_1fr] items-baseline gap-x-5 border-b border-[color:var(--color-line)] py-4 sm:grid-cols-[3rem_1fr] sm:gap-x-6">
                  <span class="font-serif text-[14px] italic text-[color:var(--color-muted)] tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                  <a
                    href={q.href}
                    rel="external noopener"
                    target="_blank"
                    class="link-underline text-[15.5px] text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-sandstone)]"
                  >
                    {q.label}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

    </article>
  </main>
  <Footer />
</Base>
