---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getInstitutionPath, institutionen } from "../data/institutionen";

const title = "Institutionen in Untereuerheim | Vereine, Kirche, Mühle und Orte";
const description =
  "Lokale Übersicht zu Institutionen in Untereuerheim: SV 1945 Untereuerheim, St. Gallus, Schlossmühle, KÖB, Mainbrückenverein und Kriegerdenkmal.";

const siteOrigin = Astro.site ?? new URL("/", Astro.url.origin);
const pageUrl = new URL("/institutionen/", siteOrigin).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl,
      url: pageUrl,
      name: title,
      description,
      inLanguage: "de-DE",
      isPartOf: { "@id": new URL("#website", siteOrigin).toString() },
      about: { "@id": new URL("#untereuerheim", siteOrigin).toString() },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: institutionen.map((inst, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: inst.name,
          url: new URL(getInstitutionPath(inst), siteOrigin).toString(),
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Untereuerheim", item: siteOrigin.toString() },
        { "@type": "ListItem", position: 2, name: "Institutionen", item: pageUrl },
      ],
    },
  ],
};
---
<Base title={title} description={description} structuredData={structuredData}>
  <Nav />
  <main id="hauptinhalt">
    <section class="relative">
      <div class="mx-auto max-w-6xl px-6 pt-36 pb-16 sm:px-8 sm:pt-48 sm:pb-24">
        <div class="reveal max-w-3xl">
          <p class="mb-6 inline-flex items-center gap-3 font-sans text-[11px] uppercase tracking-[0.32em] text-[color:var(--color-muted)]">
            <span class="h-px w-10 bg-[color:var(--color-line-strong)]"></span>
            Lokaler Überblick
          </p>
          <h1 class="font-serif text-[clamp(3rem,8vw,7rem)] leading-[0.9] tracking-[-0.025em] text-[color:var(--color-ink)]">
            Institutionen<span class="text-[color:var(--color-sandstone)]">.</span>
          </h1>
          <p class="mt-8 max-w-2xl font-serif text-[clamp(1.2rem,2vw,1.55rem)] italic leading-[1.3] text-[color:var(--color-ink-soft)]">
            Vereine, Kirche, Mühle, Bücherei und Erinnerungsorte in Untereuerheim.
          </p>
        </div>

        <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {institutionen.map((inst) => (
            <a
              href={getInstitutionPath(inst)}
              class="reveal group flex flex-col overflow-hidden rounded-2xl bg-[color:var(--color-paper-2)]/85 ring-1 ring-[color:var(--color-line)] transition-all duration-500 hover:-translate-y-1 hover:bg-[color:var(--color-paper-2)] hover:shadow-[var(--shadow-soft)] hover:ring-[color:var(--color-line-strong)]"
            >
              <div class="relative aspect-[4/3] w-full overflow-hidden">
                <Image
                  src={inst.image}
                  alt={inst.imageAlt}
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <h2 class="font-serif text-2xl leading-tight">{inst.name}</h2>
                <p class="mt-2 text-[12px] uppercase tracking-[0.18em] text-[color:var(--color-muted)]">{inst.meta}</p>
                <p class="mt-5 text-[15px] leading-relaxed text-[color:var(--color-ink-soft)]">{inst.description}</p>
                <span class="mt-8 text-[13px] text-[color:var(--color-sandstone)]">
                  <span class="link-underline">Profil ansehen</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
